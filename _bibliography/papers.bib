@article{Xia:2016ch,
	abstract = {The trade-off hypothesis, the current paradigm of arbovirus evolution, proposes that cycling between vertebrate and invertebrate hosts presents significant constraints on genetic change of arboviruses. Studying these constraints in mosquito-borne viruses has led to a new understanding of epizootics. The trade-off hypothesis is assumed to be applicable to tick-borne viruses too, although studies are lacking. Tick-borne Crimean-Congo hemorrhagic fever virus (CCHFV), a member of the family Bunyaviridae, is a major cause of severe human disease worldwide and shows an extraordinary amount of genetic diversity compared to other arboviruses, which has been linked to increased virulence and emergence in new environments. Using a transmission model for CCHFV, utilizing the main vector tick species and mice plus next generation sequencing, we detected a substantial number of consensus-level mutations in CCHFV recovered from ticks after only a single transstadial transmission, whereas none were detected in CCHFV obtained from the mammalian host. Furthermore, greater viral intra-host diversity was detected in the tick compared to the vertebrate host. Long-term association of CCHFV with its tick host for 1 year demonstrated mutations in the viral genome become fixed over time. These findings suggest that the trade-off hypothesis may not be accurate for all arboviruses.},
	affiliation = {Department of Microbiology and Immunology, University of Texas Medical Branch, Galveston, TX, USA.},
	author = {Xia, Han and Beck, Andrew S and Gargili, Aysen and Forrester, Naomi and Barrett, Alan D T and Bente, Dennis A},
	date-added = {2017-04-10T08:02:39GMT},
	date-modified = {2017-07-10T02:06:06GMT},
	doi = {10.1038/srep35819},
	file = {{E7869A3F-DC14-4480-9D29-E829A9F32D3A.pdf:/Users/andrewbeck/Dropbox/Library.papers3/Files/E7/E7869A3F-DC14-4480-9D29-E829A9F32D3A.pdf:application/pdf}},
	journal = {Scientific Reports},
	language = {English},
	local-url = {file://localhost/Users/andrewbeck/Dropbox/Library.papers3/Files/E7/E7869A3F-DC14-4480-9D29-E829A9F32D3A.pdf},
	month = oct,
	number = {1},
	pages = {35819},
	pmcid = {PMC5075774},
	pmid = {27775001},
	publisher = {Nature Publishing Group},
	rating = {0},
	title = {{Transstadial Transmission and Long-term Association of Crimean-Congo Hemorrhagic Fever Virus in Ticks Shapes Genome Plasticity.}},
	uri = {\url{papers3://publication/doi/10.1038/srep35819}},
	url = {http://www.nature.com/articles/srep35819},
