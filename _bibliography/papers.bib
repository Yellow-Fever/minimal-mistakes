@article{Wang:2022aa,
	abstract = {The evolution of severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) has resulted in the emergence of new variant lineages that have exacerbated the COVID-19 pandemic. Some of those variants were designated as variants of concern/interest (VOC/VOI) by national or international authorities based on many factors including their potential impact on vaccine-mediated protection from disease. To ascertain and rank the risk of VOCs and VOIs, we analyze the ability of 14 variants (614G, Alpha, Beta, Gamma, Delta, Epsilon, Zeta, Eta, Theta, Iota, Kappa, Lambda, Mu, and Omicron) to escape from mRNA vaccine-induced antibodies. The variants show differential reductions in neutralization and replication by post-vaccination sera. Although the Omicron variant (BA.1, BA.1.1, and BA.2) shows the most escape from neutralization, sera collected after a third dose of vaccine (booster sera) retain moderate neutralizing activity against that variant. Therefore, vaccination remains an effective strategy during the COVID-19 pandemic.},
	author = {Wang, Li and Kainulainen, Markus H. and Jiang, Nannan and Di, Han and Bonenfant, Gaston and Mills, Lisa and Currier, Michael and Shrivastava-Ranjan, Punya and Calderon, Brenda M. and Sheth, Mili and Mann, Brian R. and Hossain, Jaber and Lin, Xudong and Lester, Sandra and Pusch, Elizabeth A. and Jones, Joyce and Cui, Dan and Chatterjee, Payel and Jenks, M. Harley and Morantz, Esther K. and Larson, Gloria P. and Hatta, Masato and Harcourt, Jennifer L. and Tamin, Azaibi and Li, Yan and Tao, Ying and Zhao, Kun and Lacek, Kristine and Burroughs, Ashley and Wang, Wei and Wilson, Malania and Wong, Terianne and Park, So Hee and Tong, Suxiang and Barnes, John R. and Tenforde, Mark W. and Self, Wesley H. and Shapiro, Nathan I. and Exline, Matthew C. and Files, D. Clark and Gibbs, Kevin W. and Hager, David N. and Patel, Manish and Halpin, Alison L. and McMullan, Laura K. and Lee, Justin S. and Xia, Hongjie and Xie, Xuping and Shi, Pei-Yong and Davis, C. Todd and Spiropoulou, Christina F. and Thornburg, Natalie J. and Oberste, M. Steven and Dugan, Vivien G. and Batra, Dhwani and Beck, Andrew S. and Caravas, Jason and Chau, Reina and Cintron-Moret, Roxana and Cook, Peter W. and Gerhart, Jonathan and Gulvik, Christopher A. and Hassell, Norman and Howard, Dakota and Knipe, Kristen and Kondor, Rebecca J. and Kovacs, Nicholas A. and Moser, Kara and Reddy-Nagilla, Roopa and Paden, Clinton R. and Rambo-Martin, Benjamin and Mathew, Sandra and Schmerer, Matthew W. and Shepard, Samuel S. and Shirk, Philip and Stanton, Richard A. and Stark, Thomas J. and Sula, Erisa and Tymeckia, Kendall and Unoarumhi, Yvette and Subbalakshmi, Voleti and Zheng, Xiao-yu and Wentworth, David E. and Zhou, Bin and SSEV Bioinformatics Working Group},
	date = {2022},
	date-added = {2025-01-28 23:12:22 -0500},
